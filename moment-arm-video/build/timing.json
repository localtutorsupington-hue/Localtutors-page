    },
    {
     "text": "The weight is close.",
     "start": 38.435,
     "end": 39.76
    },
    {
     "text": "Easier.",
     "start": 40.08,
     "end": 40.74
    },
    {
     "text": "Arm sticking straight out?",
     "start": 41.06,
