    {
     "text": "Hi friends!",
     "start": 0.6,
     "end": 1.831
    },
    {
     "text": "Why do some lifts feel heavier than others?",
     "start": 2.151,
     "end": 4.757
    },
    {
     "text": "Let's find out!",
     "start": 5.077,
     "end": 6.076
    }
   ],
   "end": 6.826
  },
  {
   "scene": 2,
   "start": 6.826,
   "sentences": [
    {
     "text": "Hold a heavy backpack close to your chest.",
     "start": 6.826,
     "end": 9.437
    },
    {
     "text": "Easy!",
     "start": 9.757,
     "end": 10.36
    },
    {
     "text": "Now hold it out with straight arms.",
     "start": 10.68,
     "end": 13.25
    },
